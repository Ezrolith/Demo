{
  "name": "dr-manhattan-watchmakers-son",
  "version": "0.2.0",
  "private": true,
  "description": "A Watchmen fan game: play Jon Osterman's journey to Dr. Manhattan in the browser.",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "npx --yes http-server -c-1 -p 8080 .",
    "test": "node tests/powers.mjs && node tests/flows.mjs && node tests/smoke.mjs && node tests/saves.mjs && node tests/settings.mjs && node tests/ledger.mjs && node tests/encounters.mjs && node tests/audio.mjs && node tests/visual.mjs",
    "test:powers": "node tests/powers.mjs",
    "test:flows": "node tests/flows.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:saves": "node tests/saves.mjs",
    "test:settings": "node tests/settings.mjs",
    "test:ledger": "node tests/ledger.mjs",
    "test:encounters": "node tests/encounters.mjs",
    "test:audio": "node tests/audio.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:bonus": "node tests/bonus.mjs",
    "test:ninth-minute": "node tests/ninth-minute.mjs",
    "test:adventures": "node tests/bonus.mjs && node tests/ninth-minute.mjs && node tests/long-summer.mjs",
    "test:long-summer": "node tests/long-summer.mjs",
    "test:after-midnight": "node tests/vigilantes.mjs && node tests/after-midnight-cases.mjs && node tests/after-midnight-modes.mjs && node tests/after-midnight-integration.mjs && node tests/surveyor-gear.mjs",
    "test:after-midnight-density": "node tests/after-midnight-density.mjs",
    "test:after-midnight-visibility": "node tests/capture-after-midnight-part-a.mjs --all-heroes --assert-contrast",
    "test:part-a": "node tools/verify-part-a.mjs",
    "test:glass-palace": "node tests/glass-palace.mjs",
    "test:glass-palace-all": "node tools/verify-glass-palace.mjs",
    "test:glass-palace-play": "node tests/play-glass-palace.mjs",
    "test:glass-palace-capture": "node tests/capture-glass-palace.mjs",
    "test:palace-refinements": "node tools/verify-palace-refinements.mjs",
    "test:palace-navigation": "node tests/glass-palace-navigation.mjs",
    "test:palace-backup": "node tests/glass-palace-backup.mjs",
    "test:palace-tracking": "node tests/glass-palace-tracking.mjs",
    "test:palace-tracking-capture": "node tests/capture-glass-palace-tracking.mjs",
    "test:palace-optionality": "node tests/glass-palace-optionality.mjs",
    "test:palace-reload": "node tests/glass-palace-reload.mjs",
    "test:palace-time-targets": "node tests/play-palace-time-targets.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
